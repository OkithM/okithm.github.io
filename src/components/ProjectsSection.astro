---
interface Project {
  id: string;
  index: string;
  title: string;
  shortTitle: string;
  mark: string;
  logo?: string;
  category: string;
  tagline: string;
  status: string;
  description: string;
  tech: string[];
  image: string;
  liveUrl: string;
  liveLabel: string;
  repoUrl?: string;
}

const projects: Project[] = [
  {
    id: "focus-track",
    index: "01",
    title: "Focus Track",
    shortTitle: "Focus Track",
    mark: "FT",
    logo: "/projectImg/focus-track-logo.webp",
    category: "Mobile App • Productivity",
    tagline: "Engineered for deep work & study consistency",
    status: "Live • 20K+ Downloads",
    description:
      "A cross-platform productivity application built with Flutter that helps students structure deep-focus sessions, track daily study streaks, and analyze time effectively.",
    tech: ["Flutter", "Dart", "Local DB", "Google Play"],
    image: "/projectImg/focus-track-bg.webp",
    liveUrl: "https://play.google.com/store/apps/details?id=com.okithm.focustrack",
    liveLabel: "View on Google Play",
  },
  {
    id: "hidden-note",
    index: "02",
    title: "Hidden Note",
    shortTitle: "Hidden Note",
    mark: "HN",
    logo: "/projectImg/hidden-note-logo.webp",
    category: "Web App • Anonymous Social",
    tagline: "Real-time Q&A messaging links",
    status: "Live Web App",
    description:
      "A secure anonymous messaging platform built with React and Firebase, enabling users to share custom prompt links and receive real-time anonymous replies with bot protection.",
    tech: ["React", "Tailwind CSS", "Firebase", "Firestore"],
    image: "/projectImg/hidden-note-bg.webp",
    liveUrl: "https://hiddennote.app",
    liveLabel: "Launch Website",
  }
];

const totalCount = String(projects.length).padStart(2, "0");

const projectsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Featured Projects by Okith Moksha",
  itemListElement: projects.map((project, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    item: {
      "@type": "SoftwareApplication",
      name: project.title,
      description: project.description,
      applicationCategory: project.category,
      url: project.liveUrl,
    },
  })),
};
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="relative min-h-screen lg:h-screen lg:min-h-160 w-full snap-start snap-always overflow-x-clip lg:overflow-hidden flex flex-col justify-center pt-20 pb-8 px-6 md:px-12 border-t border-white/10"
>
  <!-- Pre-rendered Project Preview Backdrops (Instant crossfade + crawlable alt text) -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    {projects.map((project, idx) => (
      <img
        data-project-bg
        src={project.image}
        alt={`${project.title} — ${project.tagline}`}
        loading={idx === 0 ? "eager" : "lazy"}
        decoding="async"
        class:list={[
          "absolute right-0 top-0 h-full w-full object-cover object-center transition-opacity duration-500",
          idx === 0 ? "opacity-100" : "opacity-0",
        ]}
        onerror="this.style.display='none';"
      />
    ))}
    <div class="hidden lg:block absolute inset-0 bg-linear-to-r from-pitch via-pitch/90 to-pitch/55"></div>
    <div class="lg:hidden absolute inset-0 bg-pitch/90"></div>
    <div class="absolute inset-x-0 top-0 h-24 bg-linear-to-b from-pitch to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-pitch to-transparent"></div>
  </div>

  <!-- Centered Container matching site layout -->
  <div class="relative z-10 max-w-6xl w-full mx-auto flex flex-col justify-center">
    <!-- Section Header -->
    <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
      <div>
        <div class="inline-flex items-center gap-2 text-sm bg-card border border-white/10 px-4 py-1 rounded-2xl text-slate-300 mb-3">
          <span class="w-2 h-2 rounded-full bg-accentRed"></span>
          <span>Featured Builds</span>
        </div>
        <h2
          id="projects-heading"
          class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white"
        >
          Some of My <span class="text-accentRed">Work</span>
        </h2>
      </div>

      <!-- Compact Prev / Next Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="prev-project-btn"
          aria-label="Previous project"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-300 hover:text-white bg-dark-900/80 hover:bg-dark-800 border border-zinc-800/80 hover:border-accent-red/50 backdrop-blur-md transition-all duration-200 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Prev</span>
        </button>
        <button
          type="button"
          id="next-project-btn"
          aria-label="Next project"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-300 hover:text-white bg-dark-900/80 hover:bg-dark-800 border border-zinc-800/80 hover:border-accent-red/50 backdrop-blur-md transition-all duration-200 cursor-pointer"
        >
          <span>Next</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Two-Column Grid -->
    <div class="grid lg:grid-cols-[minmax(17rem,21rem)_minmax(0,1fr)] gap-6 items-stretch">
      <!-- COMPACT PROJECT SELECTOR CARDS (Left Column) -->
      <div
        role="tablist"
        aria-label="Select a project to inspect"
        class="flex flex-col justify-start gap-3"
      >
        {projects.map((project, idx) => {
          const isFirst = idx === 0;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${project.id}`}
              aria-selected={isFirst ? "true" : "false"}
              aria-controls={`panel-${project.id}`}
              data-project-tab
              data-index={idx}
              class:list={[
                "group relative w-full flex items-center gap-3.5 px-4 py-3 rounded-2xl text-left backdrop-blur-md transition-all duration-200 cursor-pointer border",
                isFirst
                  ? "bg-card border-accentRed/60 shadow-[0_0_25px_rgba(255,51,68,0.14)]"
                  : "bg-dark-900/60 border-zinc-800/80 hover:border-accent-red/40 hover:bg-dark-800/70",
              ]}
            >
              <span
                class:list={[
                  "tab-mark shrink-0 flex items-center justify-center w-9 h-9 rounded-xl font-mono text-xs font-bold transition-all duration-200",
                  isFirst
                    ? "bg-dark-800/80 text-white border border-zinc-800"
                    : "bg-dark-800/80 text-zinc-400 border border-zinc-800 group-hover:text-white group-hover:border-accent-red/40",
                ]}
              >
                {project.logo && (
                  <img
                    src={project.logo}
                    alt={`${project.title} logo`}
                    class="h-full w-full rounded-lg object-contain"
                    onerror="this.classList.add('hidden'); this.nextElementSibling?.classList.remove('hidden');"
                  />
                )}
                <span class:list={[project.logo ? "hidden" : ""]}>
                  {project.mark}
                </span>
              </span>

              <span class="min-w-0 flex-1">
                <span
                  class:list={[
                    "tab-label block text-sm sm:text-base font-semibold truncate transition-colors",
                    isFirst ? "text-white" : "text-zinc-300 group-hover:text-white",
                  ]}
                >
                  {project.shortTitle}
                </span>
                <span class="block text-xs text-slate-400 truncate mt-0.5">
                  {project.category}
                </span>
              </span>

              <span
                class:list={[
                  "tab-index shrink-0 font-mono text-xs transition-colors",
                  isFirst ? "text-accentRed font-semibold" : "text-zinc-500 group-hover:text-zinc-300",
                ]}
              >
                {project.index}
              </span>
            </button>
          );
        })}
      </div>

      <!-- PRE-RENDERED PROJECT DETAIL PANELS (Right Column — All 4 in static HTML for SEO) -->
      <div class="relative flex">
        {projects.map((project, idx) => {
          const isFirst = idx === 0;
          return (
            <article
              role="tabpanel"
              id={`panel-${project.id}`}
              aria-labelledby={`tab-${project.id}`}
              aria-hidden={isFirst ? "false" : "true"}
              data-project-panel
              class:list={[
                "w-full rounded-2xl bg-dark-900/60 border border-zinc-800/80 hover:border-accent-red/40 backdrop-blur-md p-6 sm:p-8 flex-col justify-between shadow-lg shadow-black/30 transition-all duration-200",
                isFirst ? "flex" : "hidden",
              ]}
            >
              <div>
                <!-- Top Metadata Bar -->
                <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-zinc-800/60">
                  <div class="flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-accentRed shadow-red-sm"></span>
                    <span class="font-mono text-xs text-zinc-400">
                      {project.index} / {totalCount}
                    </span>
                    <span class="text-zinc-700">•</span>
                    <span class="text-xs font-medium text-slate-300">
                      {project.category}
                    </span>
                  </div>

                  <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    {project.status}
                  </span>
                </div>

                <!-- Project Title & Tagline -->
                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white">
                  {project.title}
                </h3>
                <p class="mt-1 text-sm sm:text-base font-medium text-accentRed">
                  {project.tagline}
                </p>

                <!-- Description -->
                <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed">
                  {project.description}
                </p>

                <!-- Tech Stack Badges -->
                <div class="mt-5 flex flex-wrap gap-2">
                  {project.tech.map((item) => (
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-800/80 border border-zinc-800 text-xs font-mono text-zinc-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-accentRed/80"></span>
                      {item}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="mt-6 pt-5 border-t border-zinc-800/60 flex flex-wrap items-center gap-3">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium text-white bg-red-gradient hover:opacity-95 shadow-red-sm hover:shadow-red-lg active:scale-[0.98] transition-all duration-300"
                >
                  <span>{project.liveLabel}</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </a>

                {project.repoUrl && (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium text-zinc-300 hover:text-white bg-dark-900/80 hover:bg-dark-800 border border-zinc-800/80 hover:border-accent-red/50 backdrop-blur-md active:scale-[0.98] transition-all duration-300"
                  >
                    <span>Source Code</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                      />
                    </svg>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Structured Data for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(projectsSchema)} />
</section>

<script>
  let currentIndex = 0;

  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-project-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-project-panel]");
  const bgImages = document.querySelectorAll<HTMLImageElement>("[data-project-bg]");
  const total = panels.length;

  function setActiveProject(index: number) {
    if (!total) return;
    const nextIndex = ((index % total) + total) % total;
    if (nextIndex === currentIndex) return;
    currentIndex = nextIndex;

    tabs.forEach((tab, i) => {
      const isActive = i === nextIndex;
      tab.setAttribute("aria-selected", String(isActive));

      tab.classList.toggle("bg-card", isActive);
      tab.classList.toggle("border-accentRed/60", isActive);
      tab.classList.toggle("shadow-[0_0_25px_rgba(255,51,68,0.14)]", isActive);
      tab.classList.toggle("bg-dark-900/60", !isActive);
      tab.classList.toggle("border-zinc-800/80", !isActive);
      tab.classList.toggle("hover:border-accent-red/40", !isActive);
      tab.classList.toggle("hover:bg-dark-800/70", !isActive);

      const markSpan = tab.querySelector(".tab-mark");
      if (markSpan) {
        markSpan.classList.toggle("text-white", isActive);
        markSpan.classList.toggle("bg-dark-800/80", !isActive);
        markSpan.classList.toggle("text-zinc-400", !isActive);
        markSpan.classList.toggle("group-hover:text-white", !isActive);
        markSpan.classList.toggle("group-hover:border-accent-red/40", !isActive);
      }

      const labelSpan = tab.querySelector(".tab-label");
      if (labelSpan) {
        labelSpan.classList.toggle("text-white", isActive);
        labelSpan.classList.toggle("text-zinc-300", !isActive);
        labelSpan.classList.toggle("group-hover:text-white", !isActive);
      }

      const idxSpan = tab.querySelector(".tab-index");
      if (idxSpan) {
        idxSpan.classList.toggle("text-accentRed", isActive);
        idxSpan.classList.toggle("font-semibold", isActive);
        idxSpan.classList.toggle("text-zinc-500", !isActive);
        idxSpan.classList.toggle("group-hover:text-zinc-300", !isActive);
      }
    });

    panels.forEach((panel, i) => {
      const isActive = i === nextIndex;
      panel.classList.toggle("hidden", !isActive);
      panel.classList.toggle("flex", isActive);
      panel.setAttribute("aria-hidden", String(!isActive));
    });

    bgImages.forEach((img, i) => {
      const isActive = i === nextIndex;
      img.classList.toggle("opacity-100", isActive);
      img.classList.toggle("opacity-0", !isActive);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      setActiveProject(Number(tab.dataset.index));
    });
  });

  document.getElementById("prev-project-btn")?.addEventListener("click", () => {
    setActiveProject(currentIndex - 1);
  });

  document.getElementById("next-project-btn")?.addEventListener("click", () => {
    setActiveProject(currentIndex + 1);
  });

  window.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    const section = document.getElementById("projects");
    if (!section) return;

    const rect = section.getBoundingClientRect();
    const isVisible =
      rect.top < window.innerHeight * 0.6 && rect.bottom > window.innerHeight * 0.4;
    if (!isVisible) return;

    setActiveProject(e.key === "ArrowRight" ? currentIndex + 1 : currentIndex - 1);
  });
</script>