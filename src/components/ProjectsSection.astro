---
interface Project {
  id: string;
  index: string;
  title: string;
  shortTitle: string;
  mark: string;
  category: string;
  tagline: string;
  status: string;
  description: string;
  tech: string[];
  image: string;
  liveUrl: string;
  liveLabel: string;
  repoUrl?: string;
}

const projects: Project[] = [
  {
    id: "focus-track",
    index: "01",
    title: "Focus Track",
    shortTitle: "Focus Track",
    mark: "FT",
    category: "Mobile App • Productivity",
    tagline: "Engineered for deep work & study consistency",
    status: "Live • 20K+ Downloads",
    description:
      "A cross-platform productivity application built with Flutter that helps students structure deep-focus sessions, track daily study streaks, and analyze time effectively.",
    tech: ["Flutter", "Dart", "Local DB", "Google Play"],
    image: "/projectImg/focus-track-bg.jpg",
    liveUrl: "https://play.google.com/store",
    liveLabel: "View on Google Play",
  },
  {
    id: "hidden-note",
    index: "02",
    title: "Hidden Note",
    shortTitle: "Hidden Note",
    mark: "HN",
    category: "Web App • Anonymous Social",
    tagline: "Real-time encrypted Q&A messaging links",
    status: "Live Web App",
    description:
      "A secure anonymous messaging platform built with React and Firebase, enabling users to share custom prompt links and receive real-time anonymous replies with bot protection.",
    tech: ["React", "Tailwind CSS", "Firebase", "Firestore"],
    image: "/projectImg/hidden-note-bg.png",
    liveUrl: "https://hiddennote.app",
    liveLabel: "Launch Website",
  },
  {
    id: "sync-story",
    index: "03",
    title: "SyncStory",
    shortTitle: "SyncStory",
    mark: "SS",
    category: "Cross-Platform • Audio Utility",
    tagline: "Serverless audiobook progress synchronization",
    status: "Desktop & Android",
    description:
      "A serverless audiobook companion for Android and Windows that automatically syncs playback timestamps across devices using Google Drive OAuth 2.0 and Supabase.",
    tech: ["Flutter", "Supabase", "Google Drive API", "OAuth 2.0"],
    image: "/images/projects/sync-story-bg.png",
    liveUrl: "https://github.com/okithm",
    liveLabel: "Explore Project",
    repoUrl: "https://github.com/okithm",
  },
  {
    id: "spot-finder",
    index: "04",
    title: "SpotFinder",
    shortTitle: "SpotFinder",
    mark: "SF",
    category: "Web App • Geolocation",
    tagline: "Real-time interactive wildlife sighting map",
    status: "Serverless PWA",
    description:
      "A mobile-first serverless web application designed for pinning, filtering, and sharing real-time local animal sightings on a high-performance interactive map.",
    tech: ["TypeScript", "Tailwind CSS", "Serverless", "Maps API"],
    image: "/images/projects/spot-finder-bg.png",
    liveUrl: "https://github.com/okithm",
    liveLabel: "Launch Website",
    repoUrl: "https://github.com/okithm",
  },
];
---

<section
  id="projects"
  class="relative h-screen min-h-160 w-full snap-start snap-always overflow-hidden flex flex-col justify-center pt-20 pb-8 px-6 md:px-12 border-t border-white/10"
>
  <!-- Subtle Project Preview Backdrop (Blends into site's bg-pitch) -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <img
      id="stage-bg-image"
      src={projects[0].image}
      alt={projects[0].title}
      class="absolute right-0 top-0 h-full w-full object-cover object-center transition-opacity duration-500"
      onerror="this.style.opacity='0';"
    />
    <div class="hidden lg:block absolute inset-0 bg-linear-to-r from-pitch via-pitch/90 to-pitch/55"></div>
    <div class="lg:hidden absolute inset-0 bg-pitch/90"></div>
    <div class="absolute inset-x-0 top-0 h-24 bg-linear-to-b from-pitch to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-pitch to-transparent"></div>
  </div>

  <!-- Centered Container matching site layout -->
  <div class="relative z-10 max-w-6xl w-full mx-auto flex flex-col justify-center">
    <!-- Section Header (Matches Hero Badge & Typography) -->
    <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
      <div>
        <div class="inline-flex items-center gap-2 text-sm bg-card border border-white/10 px-4 py-1 rounded-2xl text-slate-300 mb-3">
          <span class="w-2 h-2 rounded-full bg-accentRed"></span>
          <span>Featured Builds</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
          Some of My <span class="text-accentRed">Work</span>
        </h2>
      </div>

      <!-- Compact Prev / Next Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="prev-project-btn"
          aria-label="Previous project"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-300 hover:text-white bg-dark-900/80 hover:bg-dark-800 border border-zinc-800/80 hover:border-accent-red/50 backdrop-blur-md transition-all duration-200 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Prev</span>
        </button>
        <button
          type="button"
          id="next-project-btn"
          aria-label="Next project"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-300 hover:text-white bg-dark-900/80 hover:bg-dark-800 border border-zinc-800/80 hover:border-accent-red/50 backdrop-blur-md transition-all duration-200 cursor-pointer"
        >
          <span>Next</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Two-Column Grid -->
    <div class="grid lg:grid-cols-[minmax(17rem,21rem)_minmax(0,1fr)] gap-6 items-stretch">
      <!-- COMPACT PROJECT SELECTOR CARDS (Left Column) -->
      <div
        role="tablist"
        aria-label="Select a project to inspect"
        class="flex flex-col justify-between gap-2.5"
      >
        {projects.map((project, idx) => {
          const isFirst = idx === 0;
          return (
            <button
              type="button"
              role="tab"
              aria-selected={isFirst ? "true" : "false"}
              data-project-tab
              data-index={idx}
              class:list={[
                "group relative w-full flex items-center gap-3.5 px-4 py-3 rounded-2xl text-left backdrop-blur-md transition-all duration-200 cursor-pointer border",
                isFirst
                  ? "bg-card border-accentRed/60 shadow-[0_0_25px_rgba(255,51,68,0.14)]"
                  : "bg-dark-900/60 border-zinc-800/80 hover:border-accent-red/40 hover:bg-dark-800/70",
              ]}
            >
              <!-- Compact Monogram Badge -->
              <span
                class:list={[
                  "tab-mark shrink-0 flex items-center justify-center w-9 h-9 rounded-xl font-mono text-xs font-bold transition-all duration-200",
                  isFirst
                    ? "bg-red-gradient text-white shadow-red-sm"
                    : "bg-dark-800/80 text-zinc-400 border border-zinc-800 group-hover:text-white group-hover:border-accent-red/40",
                ]}
              >
                {project.mark}
              </span>

              <!-- Compact Title & Category -->
              <span class="min-w-0 flex-1">
                <span
                  class:list={[
                    "tab-label block text-sm sm:text-base font-semibold truncate transition-colors",
                    isFirst ? "text-white" : "text-zinc-300 group-hover:text-white",
                  ]}
                >
                  {project.shortTitle}
                </span>
                <span class="block text-xs text-slate-400 truncate mt-0.5">
                  {project.category}
                </span>
              </span>

              <!-- Index Number -->
              <span
                class:list={[
                  "tab-index shrink-0 font-mono text-xs transition-colors",
                  isFirst ? "text-accentRed font-semibold" : "text-zinc-500 group-hover:text-zinc-300",
                ]}
              >
                {project.index}
              </span>
            </button>
          );
        })}
      </div>

      <!-- ACTIVE PROJECT DETAILS CARD (Right Column — Matches Card.astro & SkillCard.astro) -->
      <div
        id="stage-detail-content"
        class="relative rounded-2xl bg-dark-900/60 border border-zinc-800/80 hover:border-accent-red/40 backdrop-blur-md p-6 sm:p-8 flex flex-col justify-between shadow-lg shadow-black/30 transition-all duration-200"
      >
        <div>
          <!-- Top Metadata Bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-zinc-800/60">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-accentRed shadow-red-sm"></span>
              <span id="stage-counter" class="font-mono text-xs text-zinc-400">
                01 / 04
              </span>
              <span class="text-zinc-700">•</span>
              <span id="stage-category" class="text-xs font-medium text-slate-300">
                {projects[0].category}
              </span>
            </div>

            <span
              id="stage-status-pill"
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              {projects[0].status}
            </span>
          </div>

          <!-- Project Title & Tagline -->
          <h3
            id="stage-title"
            class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white"
          >
            {projects[0].title}
          </h3>
          <p
            id="stage-tagline"
            class="mt-1 text-sm sm:text-base font-medium text-accentRed"
          >
            {projects[0].tagline}
          </p>

          <!-- Description -->
          <p
            id="stage-description"
            class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed"
          >
            {projects[0].description}
          </p>

          <!-- Tech Stack Badges (Matches SkillCard.astro) -->
          <div id="stage-tech" class="mt-5 flex flex-wrap gap-2">
            {projects[0].tech.map((item) => (
              <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-800/80 border border-zinc-800 text-xs font-mono text-zinc-300">
                <span class="w-1.5 h-1.5 rounded-full bg-accentRed/80"></span>
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- Action Buttons (Matches ButtonPrimary.astro & ButtonSecondary.astro) -->
        <div class="mt-6 pt-5 border-t border-zinc-800/60 flex flex-wrap items-center gap-3">
          <a
            id="stage-live-btn"
            href={projects[0].liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium text-white bg-red-gradient hover:opacity-95 shadow-red-sm hover:shadow-red-lg active:scale-[0.98] transition-all duration-300"
          >
            <span id="stage-live-label">{projects[0].liveLabel}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>

          <a
            id="stage-repo-btn"
            href={projects[0].repoUrl || "#"}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium text-zinc-300 hover:text-white bg-dark-900/80 hover:bg-dark-800 border border-zinc-800/80 hover:border-accent-red/50 backdrop-blur-md active:scale-[0.98] transition-all duration-300",
              projects[0].repoUrl ? "inline-flex" : "hidden",
            ]}
          >
            <span>Source Code</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ projects }}>
  let currentIndex = 0;

  const tabs = document.querySelectorAll("[data-project-tab]");
  const detailContainer = document.getElementById("stage-detail-content");
  const bgImage = document.getElementById("stage-bg-image");

  const els = {
    counter: document.getElementById("stage-counter"),
    category: document.getElementById("stage-category"),
    title: document.getElementById("stage-title"),
    tagline: document.getElementById("stage-tagline"),
    description: document.getElementById("stage-description"),
    tech: document.getElementById("stage-tech"),
    liveBtn: document.getElementById("stage-live-btn"),
    liveLabel: document.getElementById("stage-live-label"),
    repoBtn: document.getElementById("stage-repo-btn"),
    statusPill: document.getElementById("stage-status-pill"),
  };

  function renderProject(index) {
    const project = projects[index];
    if (!project) return;
    currentIndex = index;

    tabs.forEach((tab, i) => {
      const isActive = i === index;
      tab.setAttribute("aria-selected", String(isActive));

      tab.className = `group relative w-full flex items-center gap-3.5 px-4 py-3 rounded-2xl text-left backdrop-blur-md transition-all duration-200 cursor-pointer border ${
        isActive
          ? "bg-card border-accentRed/60 shadow-[0_0_25px_rgba(255,51,68,0.14)]"
          : "bg-dark-900/60 border-zinc-800/80 hover:border-accent-red/40 hover:bg-dark-800/70"
      }`;

      const markSpan = tab.querySelector(".tab-mark");
      const labelSpan = tab.querySelector(".tab-label");
      const idxSpan = tab.querySelector(".tab-index");

      if (markSpan) {
        markSpan.className = `tab-mark shrink-0 flex items-center justify-center w-9 h-9 rounded-xl font-mono text-xs font-bold transition-all duration-200 ${
          isActive
            ? "bg-red-gradient text-white shadow-red-sm"
            : "bg-dark-800/80 text-zinc-400 border border-zinc-800 group-hover:text-white group-hover:border-accent-red/40"
        }`;
      }

      if (labelSpan) {
        labelSpan.className = `tab-label block text-sm sm:text-base font-semibold truncate transition-colors ${
          isActive ? "text-white" : "text-zinc-300 group-hover:text-white"
        }`;
      }

      if (idxSpan) {
        idxSpan.className = `tab-index shrink-0 font-mono text-xs transition-colors ${
          isActive ? "text-accentRed font-semibold" : "text-zinc-500 group-hover:text-zinc-300"
        }`;
      }
    });

    detailContainer.style.opacity = "0.35";
    bgImage.style.opacity = "0";

    setTimeout(() => {
      const total = String(projects.length).padStart(2, "0");
      els.counter.textContent = `${project.index} / ${total}`;
      els.category.textContent = project.category;
      els.title.textContent = project.title;
      els.tagline.textContent = project.tagline;
      els.description.textContent = project.description;
      els.liveBtn.href = project.liveUrl;
      els.liveLabel.textContent = project.liveLabel;

      if (els.statusPill) {
        els.statusPill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>${project.status}`;
      }

      els.tech.innerHTML = project.tech
        .map(
          (item) =>
            `<span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-800/80 border border-zinc-800 text-xs font-mono text-zinc-300"><span class="w-1.5 h-1.5 rounded-full bg-accentRed/80"></span>${item}</span>`
        )
        .join("");

      if (project.repoUrl) {
        els.repoBtn.href = project.repoUrl;
        els.repoBtn.classList.remove("hidden");
        els.repoBtn.classList.add("inline-flex");
      } else {
        els.repoBtn.classList.add("hidden");
        els.repoBtn.classList.remove("inline-flex");
      }

      bgImage.src = project.image;
      bgImage.alt = project.title;
      bgImage.onload = () => {
        bgImage.style.opacity = "1";
      };

      detailContainer.style.opacity = "1";
    }, 130);
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const idx = Number(tab.getAttribute("data-index"));
      renderProject(idx);
    });
  });

  document.getElementById("prev-project-btn")?.addEventListener("click", () => {
    renderProject((currentIndex - 1 + projects.length) % projects.length);
  });

  document.getElementById("next-project-btn")?.addEventListener("click", () => {
    renderProject((currentIndex + 1) % projects.length);
  });

  window.addEventListener("keydown", (e) => {
    const section = document.getElementById("projects");
    if (!section) return;
    const rect = section.getBoundingClientRect();
    const isVisible = rect.top < window.innerHeight * 0.6 && rect.bottom > window.innerHeight * 0.4;
    if (!isVisible) return;

    if (e.key === "ArrowRight") {
      renderProject((currentIndex + 1) % projects.length);
    } else if (e.key === "ArrowLeft") {
      renderProject((currentIndex - 1 + projects.length) % projects.length);
    }
  });
</script>