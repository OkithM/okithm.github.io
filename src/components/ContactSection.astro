---
import { Icon } from "astro-icon/components";
import ButtonPrimary from "./ButtonPrimary.astro";
import ButtonSecondary from "./ButtonSecondary.astro";

const socials = [
  {
    name: "GitHub",
    handle: "@okithm",
    href: "https://github.com/okithm",
    icon: "mdi:github",
  },
  {
    name: "LinkedIn",
    handle: "Okith Moksha",
    href: "https://www.linkedin.com/in/okith-moksha/",
    icon: "mdi:linkedin",
  },
  {
    name: "WhatsApp",
    handle: "+9476400728",
    href: "https://wa.me/+9476400728",
    icon: "mdi:whatsapp",
  },
  {
    name: "Twitter / X",
    handle: "@okithmoksha",
    href: "https://twitter.com/okithmoksha",
    icon: "mdi:twitter",
  },
];
---

<section
  aria-labelledby="contact-heading"
  class="relative z-10 w-full px-5 md:px-12 pb-16"
>
  <div class="max-w-5xl mx-auto">
    <div class="rounded-2xl bg-dark-900/60 border border-zinc-800/80 backdrop-blur-md p-8 sm:p-12 shadow-lg shadow-black/30">
      <!-- Badge -->
      <div class="inline-flex w-fit items-center gap-2 text-sm bg-card border border-white/10 px-4 py-1 rounded-2xl text-slate-300 mb-4">
        <span class="w-2 h-2 rounded-full bg-accentRed"></span>
        <span>Get in Touch</span>
      </div>

      <!-- Heading & Short Description -->
      <h2
        id="contact-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white"
      >
        Let's <span class="text-accentRed">Connect</span>
      </h2>
      <p class="mt-3 text-slate-400 max-w-xl leading-relaxed">
        I'm always open to discussing new projects, creative ideas, or opportunities. Reach out directly via email or connect on any platform below.
      </p>

      <!-- Direct Action Buttons -->
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <ButtonPrimary href="mailto:okithmoksha@gmail.com">
          <Icon name="mdi:email-outline" class="w-5 h-5" />
          <span>okithmoksha@gmail.com</span>
        </ButtonPrimary>

        <ButtonSecondary href="https://wa.me/+9476400728">
          <Icon name="mdi:whatsapp" class="w-5 h-5 text-accentRed" />
          <span>Chat on WhatsApp</span>
        </ButtonSecondary>
      </div>

      <!-- Social Links Grid -->
      <div class="mt-10 pt-8 border-t border-zinc-800/60 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 px-4 py-3 rounded-xl bg-dark-800/80 border border-zinc-800 hover:border-accent-red/40 transition-all duration-200"
          >
            <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-dark-900 border border-zinc-800 text-zinc-300 group-hover:text-accentRed transition-colors">
              <Icon name={social.icon} class="w-5 h-5" />
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-zinc-200 group-hover:text-white transition-colors">
                {social.name}
              </div>
              <div class="text-xs text-zinc-500 truncate font-mono">
                {social.handle}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>