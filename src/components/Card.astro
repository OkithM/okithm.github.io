---
interface Props {
  class?: string;
  hoverGlow?: boolean;
}

const { class: className = "", hoverGlow = true } = Astro.props;
---

<div
  class={`relative rounded-2xl bg-dark-900/60 border border-zinc-800/80 backdrop-blur-md p-6 ${
    hoverGlow ? "hover:border-accent-red/40 hover:shadow-[0_0_25px_rgba(255,51,68,0.1)] transition-all duration-300" : ""
  } ${className}`}
>
  <slot />
</div>