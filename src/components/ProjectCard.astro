---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  Url?: string;
  UrlName?: string;
  badge?: string;
}

const { title, description, image, tags, Url, UrlName, badge } = Astro.props;
---

<div class="group relative rounded-2xl bg-dark-900/70 border border-zinc-800/80 hover:border-accent-red/50 overflow-hidden backdrop-blur-md transition-all duration-300 flex flex-col h-full hover:shadow-[0_0_30px_rgba(255,51,68,0.15)]">
  <!-- Image Container -->
  <div class="relative h-48 w-full overflow-hidden bg-dark-950">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-t from-dark-900 via-dark-900/30 to-transparent"></div>
    {badge && (
      <span class="absolute top-3 right-3 px-3 py-1 text-xs font-semibold rounded-full bg-accent-red/20 text-accent-red border border-accent-red/40 backdrop-blur-md">
        {badge}
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col grow">
    <h3 class="text-xl font-bold text-white group-hover:text-accent-red transition-colors duration-200">
      {title}
    </h3>
    <p class="mt-2 text-sm text-zinc-400 line-clamp-3 grow leading-relaxed">
      {description}
    </p>

    <!-- Tech Tags -->
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="px-2.5 py-1 text-xs rounded-md bg-dark-800 text-zinc-300 border border-zinc-800 font-mono">
          {tag}
        </span>
      ))}
    </div>

    <!-- Actions -->
    <div class="mt-6 flex items-center gap-3 pt-4 border-t border-zinc-800/60">
      {Url && (
        <a
          href={Url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex justify-center items-center gap-2 py-2 text-xs font-semibold rounded-lg bg-red-gradient text-white hover:opacity-90 shadow-red-sm transition-all"
        >
          <span>{UrlName || "View Project"}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      )}
    </div>
  </div>
</div>