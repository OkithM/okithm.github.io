---
import "../styles/global.css";
import Navigation from "../components/navigation.astro";
import Terminal from "../components/Terminal.astro";
import SocialMediaIcon from "../components/SocialMediaIcon.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import SkillSection from "../components/SkillSection.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/myLogo.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Okith Moksha</title>
  </head>
  <body
    class="bg-pitch text-slate-100 font-sans selection:bg-accentRed selection:text-white relative min-h-screen overflow-x-hidden"
  >
    <div id="about" class="snap-always snap-start"></div>
    <!-- Ambient Red Lighting Effects -->
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-200 h-100 bg-accentRed/10 blur-[150px] pointer-events-none rounded-full z-0"
    >
    </div>
    <div
      class="fixed bottom-0 right-0 w-125 h-125 bg-accentRed/5 blur-[180px] pointer-events-none rounded-full z-0"
    >
    </div>

    <Navigation />

    <!-- Hero Section -->
    <section
      class="min-h-[calc(100vh-5rem)] flex-row py-12 w-full flex items-center justify-center md:pr-40 md:pl-30 px-5 relative z-10"
    >
      <div class="max-w-10 xl:flex flex-col gap-4 mr-10 hidden">
          <SocialMediaIcon name="mdi:whatsapp" href="https://wa.me/+9476400728" />
          <SocialMediaIcon name="mdi:linkedin" href="https://www.linkedin.com/in/okith-moksha/" />
          <SocialMediaIcon name="mdi:github" href="https://github.com/okithm" />
          <SocialMediaIcon name="mdi:twitter" href="https://twitter.com/okithmoksha" />
          <SocialMediaIcon name="mdi:gmail" href="https://mail.google.com/mail/u/0/?view=cm&fs=1&to=okithmoksha@gmail.com" />
      </div>
      <div class="mr-auto sm:px-6">
        <p class="text-lg bg-card border border-white/10 max-w-fit px-5 py-1 rounded-2xl">
          👋 Hello, I'm
        </p>
        <div class="h-4"></div>
        <h1 class="text-5xl font-bold">
          Okith <span class="text-accentRed">Moksha</span>
        </h1>
        <p class="text-3xl mt-2 text-slate-400">
          Crafting High Performance <br /><span class="text-accentRed">Mobile & Web</span> Experiences.
        </p>
        <div class="h-4"></div>
        <p class="text-slate-300 max-w-xl leading-relaxed">
          Full-Stack Developer (Flutter, React, Supabase), Cybersecurity CTF Competitor, and Digital Visual Designer. Studying Computer Science at University of Ruhuna, Sri Lanka.
        </p>
        <div class="max-h-10 flex flex-row gap-4 mt-10 xl:hidden">
          <SocialMediaIcon name="mdi:whatsapp" href="https://wa.me/+9476400728" />
          <SocialMediaIcon name="mdi:linkedin" href="https://www.linkedin.com/in/okith-moksha/" />
          <SocialMediaIcon name="mdi:github" href="https://github.com/okithm" />
          <SocialMediaIcon name="mdi:twitter" href="https://twitter.com/okithmoksha" />
          <SocialMediaIcon name="mdi:gmail" href="https://mail.google.com/mail/u/0/?view=cm&fs=1&to=okithmoksha@gmail.com" />
        </div>
      </div>

      <div class="hidden lg:flex min-w-120 h-120 items-center justify-center bg-card border border-white/10 rounded-2xl shadow-lg shadow-black/30">
        <Terminal title="okith@dev" />
      </div>
    </section>

    <div id="projects" class=" snap-start snap-always"></div>
    <ProjectsSection />
    <div class="h-20"></div>


    <div id="skills" class="snap-always snap-start"></div>
    <div class="pt-40"></div>
    <SkillSection/>
    
    <div id="contact" class="snap-always snap-start"></div>
    <div class="pt-40"></div>
    <ContactSection />

    <div><Footer /></div>
  </body>
</html>